# ==============================================================================
# LedgerLine Environment Variables Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env to source control.
# ==============================================================================

# Database Connectivity (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5433/ledgerline_db
DB_USER=root
DB_PASSWORD=root

# Authentication & JWT (Secret must be at least 32 bytes / 256 bits for HS256)
JWT_SECRET=replace_with_at_least_32_chars_long_random_secure_secret_key_12345
JWT_EXPIRATION_MINUTES=15

# Frontend CORS Origin (Strict single origin, never wildcard)
FRONTEND_ORIGIN=http://localhost:5173

# Server Port
PORT=8080

# Seed Passwords (Optional initial provisioning for prod/staging)
SEED_ADMIN_PASSWORD=AdminSecurePassword123!
SEED_AUDITOR_PASSWORD=AuditorSecurePassword123!
SEED_HOLDER1_PASSWORD=HolderOnePassword123!
SEED_HOLDER2_PASSWORD=HolderTwoPassword123!

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=
