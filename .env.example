# ==============================================================================
# LedgerLine Environment Variables Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit .env to source control.
# ==============================================================================

# Database Connectivity
DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
DB_USER=ledgerline_app
DB_PASSWORD=replace_with_strong_database_password

# Authentication & JWT (Secret must be at least 32 bytes / 256 bits for HS256)
JWT_SECRET=replace_with_at_least_32_chars_long_random_secure_secret_key_12345

# Frontend CORS Origin (Strict single origin, never wildcard)
FRONTEND_ORIGIN=http://localhost:5173

# Server Port
PORT=8080

